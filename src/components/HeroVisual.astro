---
import { withBase } from '../utils/paths';
import type { Metric, Screenshot } from '../content/siteContent';

interface Props {
  primary: Screenshot;
  secondary: Screenshot;
  metrics: Metric[];
}

const { primary, secondary, metrics } = Astro.props;
---

<div class="hero-visual">
  <div class="hero-visual__stack">
    <figure class="hero-device hero-device--primary">
      <div class="hero-device__frame">
        <img src={withBase(primary.src)} alt={primary.alt} loading="eager" decoding="async" />
      </div>
      <figcaption>{primary.caption}</figcaption>
    </figure>

    <figure class="hero-device hero-device--secondary">
      <div class="hero-device__frame">
        <img src={withBase(secondary.src)} alt={secondary.alt} loading="lazy" decoding="async" />
      </div>
      <figcaption>{secondary.caption}</figcaption>
    </figure>
  </div>

  <div class="hero-metrics">
    {metrics.map((metric) => (
      <article class="metric-card">
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
      </article>
    ))}
  </div>
</div>
