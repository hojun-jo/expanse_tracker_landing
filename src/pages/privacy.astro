---
import BaseLayout from '../layouts/BaseLayout.astro';
import { policies } from '../content/siteContent';
import { withBase } from '../utils/paths';

const policy = policies.ko;
---

<BaseLayout
  lang={policy.htmlLang}
  title={policy.metaTitle}
  description={policy.metaDescription}
  homeHref={withBase()}
  brandLine="Simple Expense Tracker"
  navLinks={[
    { label: policy.homeLabel, href: withBase() },
    { label: 'English', href: withBase('en/privacy/') },
  ]}
  switchHref={withBase('en/privacy/')}
  switchLabel="English"
  footerLinks={[
    { label: policy.homeLabel, href: withBase() },
    { label: 'English', href: withBase('en/privacy/') },
  ]}
  footerNote={policy.contactNote}
>
  <section class="policy-hero">
    <p class="eyebrow">Pennymint</p>
    <h1>{policy.title}</h1>
    <p class="policy-hero__summary">{policy.summary}</p>
    <p class="policy-hero__updated">{policy.updatedAt}</p>
  </section>

  <section class="policy-card">
    {policy.sections.map((section) => (
      <article class="policy-section">
        <h2>{section.title}</h2>
        {section.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </article>
    ))}
  </section>
</BaseLayout>
